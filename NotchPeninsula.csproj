<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- 添加 WinForms 支持，仅仅为了拿一下屏幕宽度 -->
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>NPS_NotchPeninsula-logo.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

	<Version>1.9.3</Version>
	</PropertyGroup>

	<ItemGroup>
		<!-- 新增的资源在这里引入 -->
    <Content Include="vcruntime140.dll" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="msvcp140.dll" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="NPS_NotchPeninsula-logo.ico" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\image\qq-icon.png" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\image\wintoast-icon.png" CopyToOutputDirectory="PreserveNewest" />
		<!-- 🔔 内置通知提示音：只引用 data\sound 下的文件，用户自选的音频不会复制进来。
		     列表由 ToastSoundConfig.RefreshBuiltins() 扫描目录动态生成 ——
		     往 data\sound 里丢新的 .wav 就能出现在设置里，不需要改这里的 csproj。
		     ⚠️ 但**新文件必须在这里登记一行**，否则发布后不会拷进输出目录。
		     显示名可在 data\sound\sound.json 里覆盖（缺失则用文件名）。 -->
		<Content Include="data\sound\sound.json" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\Tri-Tone.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\Airdrop.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\NewMail.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\Nano.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\Complete.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\Ding.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\Aurora.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\Bamboo.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\Synth.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\WeChat.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\QQ.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\QQClassic.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\QQLegacy.wav" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="data\sound\Telegram.wav" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<!-- 🔑 data\ 下的资源必须**同时**以嵌入资源打进 exe。
		     单文件发布（PublishSingleFile）只打包托管程序集与原生库，上面那些 Content 文件
		     仍会作为散文件留在 exe 旁边 —— 也就是说 exe 单独拷走就没了内置提示音和内置图标。
		     嵌入之后由 Core/DataResources.cs 统一解析（磁盘优先 → 嵌入兜底）：
		     data\ 在就优先用磁盘上的（用户可以往 data\sound 丢 wav 覆盖/新增），
		     data\ 不在就用 exe 里这份，**单文件 exe 从此真正自足**。
		     ⚠️ LogicalName 必须写，它把资源名固定成「相对路径」（如 data/sound/QQ.wav），
		     DataResources 依赖这个约定；否则资源名会变成 <RootNamespace>.data.sound.QQ.wav。
		     ⚠️ 这两个目录里新增文件不用改这里（*.* 通配），但**必须同步在上面登记 Content**，
		     否则发布时不会拷进输出目录（嵌入与磁盘两份就只剩嵌入那份了）。 -->
		<EmbeddedResource Include="data\image\*.*">
			<LogicalName>data/image/%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="data\sound\*.*">
			<LogicalName>data/sound/%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="NPS_NotchPeninsula-logo.ico">
			<LogicalName>NPS_NotchPeninsula-logo.ico</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp" Version="2.88.8" />
		<PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" />
		<!-- 音频采集库 -->
		<PackageReference Include="NAudio.Core" Version="2.2.1" />
		<PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
        <PackageReference Include="System.Management" Version="10.0.12" />
	</ItemGroup>

</Project>
